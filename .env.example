# Copie para .env e preencha. O .env NUNCA é versionado (ver .gitignore).
# Aqui só ficam placeholders: nunca escreva valores reais neste arquivo.

# ---------------------------------------------------------------------------
# API (apps/api) — lidas e validadas com Zod na inicialização (falha rápida)
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3333
# Origens permitidas, separadas por vírgula (PWA, Expo web em desenvolvimento)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Projeto Firebase (plano Spark, Firestore em southamerica-east1)
FIREBASE_PROJECT_ID=wimbledon-90871
# Conta de serviço: copie do JSON baixado no console, mas NÃO guarde o JSON no repositório
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# Entre aspas, com as quebras de linha escritas como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_A_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
TZ_PADRAO=America/Recife
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Seed da primeira conta administrativa (npm run seed:admin). Use dados da
# pessoa responsável, nunca de terceiros. Sem ADMIN_SENHA, uma é gerada.
# ADMIN_NOME=Nome Sobrenome
# ADMIN_EMAIL=admin@seu-dominio.com.br
# ADMIN_CPF=00000000000
# ADMIN_SENHA=

# Só em desenvolvimento/teste, para usar o Firebase Emulator Suite em vez do
# projeto real. Com elas definidas, FIREBASE_CLIENT_EMAIL e FIREBASE_PRIVATE_KEY
# não são exigidas.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------------------
# App (apps/mobile) — EXPO_PUBLIC_* vão para o pacote do app: são públicas.
# Nunca coloque segredo numa variável EXPO_PUBLIC_*.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3333/api/v1
EXPO_PUBLIC_FIREBASE_API_KEY=sua-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=wimbledon-90871
