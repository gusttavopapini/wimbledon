{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/cards/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/patient-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto))/i]",
        "message": "Font not provided by the design system. Available: Roboto."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|time|doctor|specialty|clinic|status|onReschedule|onDetails|key|ref|className|style|children)$/]",
        "message": "<AppointmentCard> doesn't accept that prop. Declared props: date, time, doctor, specialty, clinic, status, onReschedule, onDetails."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:agendado|pronto|concluido)$/]",
        "message": "<AppointmentCard> status must be one of 'agendado' | 'pronto' | 'concluido'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BackButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|inverse|key|ref|className|style|children)$/]",
        "message": "<BackButton> doesn't accept that prop. Declared props: label, onClick, inverse."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<BottomNavItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|fullWidth|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, fullWidth, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|whatsapp|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'whatsapp' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<CategoryChip> doesn't accept that prop. Declared props: label, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='DoctorCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|specialty|clinic|distance|photo|nextSlot|onSchedule|key|ref|className|style|children)$/]",
        "message": "<DoctorCard> doesn't accept that prop. Declared props: name, specialty, clinic, distance, photo, nextSlot, onSchedule."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:top|children|headerHeight|sheetOverlap|style|key|ref|className|style|children)$/]",
        "message": "<HeroHeader> doesn't accept that prop. Declared props: top, children, headerHeight, sheetOverlap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickAccessCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|onClick|key|ref|className|style|children)$/]",
        "message": "<QuickAccessCard> doesn't accept that prop. Declared props: kind, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickAccessCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:consultas|exames|receitas|pretriagem)$/]",
        "message": "<QuickAccessCard> kind must be one of 'consultas' | 'exames' | 'receitas' | 'pretriagem'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|cta|onClick|key|ref|className|style|children)$/]",
        "message": "<ScheduleBanner> doesn't accept that prop. Declared props: title, text, cta, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|onMic|label|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: value, onChange, placeholder, onMic, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecialtyItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|image|layout|onClick|key|ref|className|style|children)$/]",
        "message": "<SpecialtyItem> doesn't accept that prop. Declared props: label, icon, image, layout, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecialtyItem'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:tile|row)$/]",
        "message": "<SpecialtyItem> layout must be one of 'tile' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:agendado|pronto|concluido|aviso|urgente)$/]",
        "message": "<StatusBadge> status must be one of 'agendado' | 'pronto' | 'concluido' | 'aviso' | 'urgente'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|hint|error|type|inputMode|icon|multiline|id|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, onChange, placeholder, hint, error, type, inputMode, icon, multiline, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='inputMode'] > Literal[value!=/^(?:text|numeric|email|tel)$/]",
        "message": "<TextField> inputMode must be one of 'text' | 'numeric' | 'email' | 'tel'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
