rules_version = '2';

// Nenhum cliente acessa o Firestore diretamente.
// Todo acesso passa pela API (Firebase Admin SDK), que ignora estas regras.
// Estas regras não mudam: ver docs/adr/0001-api-unico-acesso-ao-banco.md
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
